rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the users collection
    match /users/{userId} {
      // Allow read and write only if the user is authenticated and is accessing their own document.
      // Note: Set up Clerk's Firebase integration to sync authentication states.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
  }
}
